# App server only. Leave URL blank for deterministic demo generation.
N8N_WEBHOOK_URL=
# Required when URL is configured. Must match n8n Webhook Header Auth.
N8N_WEBHOOK_SECRET=
# Required in webhook mode; use a distinct random value of at least 32 characters.
# n8n Callback result Header Auth: x-campaign-callback-secret = this value.
N8N_CALLBACK_SECRET=
# App origin without a trailing slash/path; Compose overrides this internally.
APP_URL=http://localhost:3000
# n8n only: must exactly equal the callback URL sent by the app.
CAMPAIGN_CALLBACK_URL=http://localhost:3000/api/webhooks/generation-complete
# Optional absolute path. Default: data/campaign-brief-studio.sqlite
CAMPAIGN_DB_PATH=
# Groq key belongs in a separate n8n Header Auth credential, not this app.
