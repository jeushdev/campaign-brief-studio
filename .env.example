# App server only. Leave URL blank for deterministic demo generation.
N8N_WEBHOOK_URL=
# Required when URL is configured. Must match n8n Webhook Header Auth.
N8N_WEBHOOK_SECRET=
# Optional absolute path. Default: data/campaign-brief-studio.sqlite
CAMPAIGN_DB_PATH=
# OpenAI key belongs in a separate n8n Header Auth credential, not this app.
